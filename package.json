{
  "name": "library-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate --schema api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema api/prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema api/prisma/schema.prisma",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@prisma/client": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx api/prisma/seed.ts"
  }
}
